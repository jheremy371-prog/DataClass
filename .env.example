# Copia este archivo a .env y reemplaza los valores de ejemplo.
# No subas .env ni claves reales al repositorio. Este archivo SOLO debe tener valores de ejemplo.
# Secreto JWT: mínimo 32 caracteres. La API no arranca si falta o sigue siendo este texto.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATACLASS_JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
DATACLASS_ADMIN_EMAIL=admin@institucion.edu
DATACLASS_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_DE_12_CARACTERES_O_MAS
DATACLASS_ADMIN_NAME=Administrador DataClass
DATACLASS_API_URL=http://127.0.0.1:8000/api/v1
# Solo si se habilita sincronización real; guarda el JSON fuera del proyecto.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_COLLECTION=estudiantes

# Sincronización automática en segundo plano con la API (1 = activada). Requiere FIREBASE_CREDENTIALS_PATH.
DATACLASS_SYNC_AUTO=0
# Clave secreta con la que se calcula el seudónimo de cada estudiante en la nube (H-03). Mínimo 32 caracteres.
# Guárdala FUERA de la nube y del repositorio: quien la tenga puede relacionar los seudónimos con los IDs reales.
# Si la pierdes o la cambias, los documentos ya subidos quedan huérfanos. Sin ella no se envía nada a Firestore.
DATACLASS_SEUDONIMO_CLAVE=REEMPLAZA-con-un-texto-largo-y-aleatorio
# Segundos entre sincronizaciones; con fallos de red la espera se duplica hasta 10 minutos.
DATACLASS_SYNC_INTERVALO=30
# Intentos fallidos de login antes del bloqueo temporal de 5 minutos (por correo y por IP).
DATACLASS_LOGIN_MAX_INTENTOS=5
DATACLASS_LOGIN_MAX_INTENTOS_IP=30

# --- Auditoría, retención y HTTPS (v1.8) ---
# Días que se conserva la bitácora de auditoría antes de poder depurarla (mínimo 30). Defínelo con tu asesor legal.
DATACLASS_AUDITORIA_RETENCION_DIAS=730
# Carpeta para el archivo de log rotativo (opcional; si se omite, solo se escribe en consola).
DATACLASS_LOG_DIR=
# 1 = la API envía Strict-Transport-Security. Actívalo SOLO cuando el sitio se sirva realmente por HTTPS.
DATACLASS_FORZAR_HTTPS=0

# --- Contraseñas y documentación (v1.8.1) ---
# Crea al directivo SIN dejar la clave aquí:  python -m api.crear_admin --correo tu@institucion.edu
# DATACLASS_ADMIN_PASSWORD solo sirve para crear al PRIMER directivo si aún no existe ninguno; después, bórrala.
# 1 = publica /docs, /redoc y /openapi.json (solo en desarrollo; en producción déjalo en 0).
DATACLASS_DOCS=0

# --- Modelo de riesgo ---
# Con un modelo sintético (datos inventados) NO se calcula el semáforo ni se crean alertas automáticas.
# 1 = permitirlo solo para demostraciones con datos inventados. Nunca con datos reales.
DATACLASS_MODO_DEMO=0

# --- Carga masiva (CSV / Excel) ---
# Tamaño máximo del archivo en MB y máximo de filas por archivo.
DATACLASS_IMPORT_MAX_MB=5
DATACLASS_IMPORT_MAX_FILAS=5000

# --- Verificación de DNI con RENIEC (Scrall) ---
# Clave de dashboard.scrall.net (Integración > Aplicaciones) con el endpoint reniec_basico habilitado.
# Solo en el servidor de la API; nunca en el navegador ni en Git. Vacía = el botón «Verificar en RENIEC» avisa que no está configurado.
SCRALL_API_KEY=
SCRALL_DNI_URL=https://api.scrall.net/v1/reniec/basico
SCRALL_AUTH_SCHEME=Basic

# --- Sesión y base de datos (v1.9.0) ---
# Minutos sin usar la pantalla antes de cerrar la sesión automáticamente (0 = sin límite).
DATACLASS_INACTIVIDAD_MIN=30
# 0 (recomendado) = el token de sesión NO se guarda en el navegador: al recargar la página hay que iniciar sesión de nuevo.
# 1 = cookie de 8 h escrita con JavaScript (no puede ser HttpOnly: un XSS podría leer el token). Solo si aceptas ese riesgo.
DATACLASS_SESION_PERSISTENTE=0
# 1 = SQLite en modo WAL (recomendado: lecturas y escritura a la vez sin bloqueos). 0 = modo clásico.
# En modo WAL aparecen junto a la base los archivos .db-wal y .db-shm: contienen datos personales, trátalos igual que la base.
DATACLASS_SQLITE_WAL=1
